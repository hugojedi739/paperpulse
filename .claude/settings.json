{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push -u origin refactor/*)",
      "Bash(git push -u origin test/*)",
      "Bash(git push -u origin style/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push origin refactor/*)",
      "Bash(git push origin test/*)",
      "Bash(git push origin style/*)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Bash(git push *main*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *--delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git push *--prune*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git -C * push *)",
      "Bash(git -c * push *)",
      "Bash(gh repo edit *--visibility*)",
      "Bash(gh api *visibility*)",
      "Bash(gh api *private=*)",
      "Bash(gh api *git/refs*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *--method DELETE*)"
    ]
  }
}
