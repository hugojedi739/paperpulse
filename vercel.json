{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'Sin build en Vercel: public/ se genera y se versiona con npm run build:static'",
  "functions": {
    "server.py": {
      "maxDuration": 60,
      "includeFiles": "{backend,frontend}/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)\\.([0-9a-f]{8})\\.(js|mjs|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/vendor/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
