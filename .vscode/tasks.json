{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Servidor de desarrollo",
      "type": "shell",
      "command": "python server.py",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^__never__$" },
        "background": { "activelyMatching": true, "beginsPattern": "Started server process", "endsPattern": "Application startup complete" }
      }
    },
    {
      "label": "Tests (frontend + servidor)",
      "type": "shell",
      "command": "npm test && python -m unittest discover -s tests -p 'test_*.py'",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Actualizar dependencias de frontend (vendor)",
      "type": "shell",
      "command": "npm install && npm run vendor",
      "problemMatcher": []
    },
    {
      "label": "Capturas de pantalla",
      "type": "shell",
      "command": "npm run screenshots",
      "problemMatcher": []
    }
  ]
}
