# ==============================================================================
# PaperPulse Terminal - Variables de Entorno y Configuración
# ==============================================================================
# Copia este archivo como .env para personalizar tu entorno:
#   copy .env.example .env

# 1. Inteligencia Artificial (Anthropic Claude)
# Guarda aquí tu clave secreta de Anthropic. El navegador NUNCA tendrá acceso a ella.
ANTHROPIC_API_KEY=

# Modelo oficial de Claude (Haiku 5.5: lanzado en oct 2026, alto rendimiento y ultra-bajo coste)
ANTHROPIC_MODEL=claude-haiku-5-5

# 2. Servidor y Red
PORT=8000
DEBUG=False

# Dominios permitidos por CORS separados por comas (en prod: https://tu-dominio.com)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Proxies de confianza (para extraer la IP real de clientes desde X-Forwarded-For)
TRUSTED_PROXIES=127.0.0.1,::1

# 3. Control de Gasto y Límites de Tokens
# Límite global diario de tokens de Anthropic (prompt + completion)
DAILY_GLOBAL_TOKEN_LIMIT=1000000

# Límite diario de tokens por usuario/IP
DAILY_USER_TOKEN_LIMIT=100000

# Límite diario de peticiones de chat por IP
DAILY_USER_CHAT_REQUESTS=100

# Clave secreta opcional para acceder a diagnósticos internos (/api/health?key=...)
ADMIN_API_KEY=

# 4. Proveedor de Datos de Bolsa (Opcional)
# 'yfinance' para desarrollo local sin claves; 'finnhub' para despliegue oficial
STOCK_DATA_PROVIDER=yfinance
# Si dispones de clave gratuita de Finnhub (60 req/min para US equities):
FINNHUB_API_KEY=
