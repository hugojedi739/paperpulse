# ==============================================================================
# PaperPulse — variables de entorno
# ==============================================================================
# Copia este archivo como .env:  cp .env.example .env
# Las claves de terceros y el inicio de sesión con Google/Okta también se pueden
# configurar desde el panel de administración (#/admin); lo guardado allí tiene prioridad.

# 1. Servidor
PORT=8000
DEBUG=False
# REALTIME=false                # desactiva el relay /ws/market en /api/health (el navegador usa solo REST)
# ENV=production                 # activa HSTS, cookies __Host- y Secure, CSP sin localhost
# APP_DOMAIN=https://tu-dominio  # obligatorio en producción (canonical, OG y URIs de redirección OAuth)
# SERVE_FRONTEND=true            # false si frontend/ se sirve desde otro servidor (CDN, nginx)

# Orígenes permitidos por CORS (solo si el frontend está en otro dominio)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Proxies de confianza (para extraer la IP real de X-Forwarded-For)
TRUSTED_PROXIES=127.0.0.1,::1

# 2. Base de datos (libSQL)
# Turso (persistente; necesario en Vercel). Si no se definen ambas, se usa un fichero local.
# TURSO_DATABASE_URL=libsql://nombre-organizacion.turso.io
# TURSO_AUTH_TOKEN=
# Fichero local libSQL/SQLite (por defecto ./data/paperpulse.db; en un dev container cuyo /workspaces sea una carpeta
# compartida, p. ej. virtiofs, ~/.local/share/paperpulse/paperpulse.db). Nunca en una carpeta compartida o de red.
# DATABASE_PATH=/ruta/a/paperpulse.db

# 3. Administración
# Emails que reciben el rol de administrador al registrarse o iniciar sesión (separados por comas).
# Alternativa: python -m backend.db admin tu@email.com
ADMIN_EMAILS=
# Clave opcional para monitorizar /api/health sin sesión (cabecera X-Admin-Key)
ADMIN_API_KEY=

# 4. Inicio de sesión (editable en el panel de administración)
AUTH_PASSWORD_ENABLED=true
AUTH_REGISTRATION_ENABLED=true
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_OKTA_ENABLED=false
# Issuer del servidor de autorización de Okta, p. ej. https://tu-org.okta.com/oauth2/default
OAUTH_OKTA_ISSUER=
OAUTH_OKTA_CLIENT_ID=
OAUTH_OKTA_CLIENT_SECRET=

# 5. Asistente IA (Anthropic). La clave solo la usa el servidor; el navegador nunca la ve.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_MAX_TOKENS=1800
# Esfuerzo de razonamiento: low (por defecto, gasta menos), medium, high... o auto para el del modelo (editable en el panel)
# ANTHROPIC_EFFORT=low

# Límites de gasto: tokens diarios globales y por IP, y mensajes diarios por IP
DAILY_GLOBAL_TOKEN_LIMIT=1000000
DAILY_USER_TOKEN_LIMIT=100000
DAILY_USER_CHAT_REQUESTS=100

# 6. Cuenta de práctica del servidor (usuarios con sesión; editable en el panel)
# Saldo inicial de las cuentas nuevas en USD, comisión y deslizamiento en puntos básicos (10 = 0,10 %)
TRADING_INITIAL_BALANCE_USD=10000
TRADING_FEE_BPS=10
TRADING_SLIPPAGE_BPS=5

# Clave del cron diario de Vercel (/api/cron/daily). Vercel la envía como `Authorization: Bearer <CRON_SECRET>`.
# Usa el MISMO valor que ADMIN_API_KEY (por ejemplo: openssl rand -hex 32). Sin ninguna de las dos, el endpoint rechaza todo.
CRON_SECRET=
# Saldo inicial (USD) del reto mensual, igual para todas las personas participantes
CHALLENGE_INITIAL_BALANCE_USD=10000

# Comunidad: operaciones mínimas para aparecer en la clasificación (editable en el panel)
COMMUNITY_MIN_TRADES=5

# 7. Datos de bolsa: 'yfinance' (sin clave) o 'finnhub' (requiere FINNHUB_API_KEY)
STOCK_DATA_PROVIDER=yfinance
FINNHUB_API_KEY=
